{
  "name": "ai-investment-api",
  "account_id": "0f9bb71bb987011462a91596f7cc9e6f",
  "main": "src/api.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "PUBLIC_DB",
      "database_name": "ai-investment-public",
      "database_id": "cf0f6bf8-142a-4c48-8468-4f9a5b1a42b3",
      "migrations_dir": "migrations/public"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
