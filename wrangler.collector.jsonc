{
  "name": "ai-investment-collector",
  "account_id": "0f9bb71bb987011462a91596f7cc9e6f",
  "main": "src/collector.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 18 * * *",
      "47 18 * * *",
      "*/5 18-23 * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "AGENT_ENABLED": "false",
    "COLLECTION_CRON": "17 18 * * *",
    "COLLECTION_ENABLED": "true",
    "WATCHDOG_CRON": "47 18 * * *",
    "GPU_RESUME_CRON": "*/5 18-23 * * *"
  },
  "d1_databases": [
    {
      "binding": "PRIVATE_DB",
      "database_name": "ai-investment-private",
      "database_id": "f9239883-9929-4137-8079-5a03d9a8beb2",
      "migrations_dir": "migrations/private"
    },
    {
      "binding": "PUBLIC_DB",
      "database_name": "ai-investment-public",
      "database_id": "cf0f6bf8-142a-4c48-8468-4f9a5b1a42b3",
      "migrations_dir": "migrations/public"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "ai-investment-evidence-private"
    }
  ]
}
